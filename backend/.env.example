# Chat Completions compatible provider.
AI_API_KEY=replace-with-local-secret
# The base URL ends at /v1; the client appends /chat/completions.
AI_BASE_URL=https://api.example.com/v1
# Configure model identifiers supported by the selected provider. The speech model must
# accept input_audio content and the asr_options request field used by src/ai_client.py.
AI_MODEL_VISION=vision-model
AI_MODEL_TEXT=text-model
AI_MODEL_ASR=speech-model

# Flask runtime. A token is mandatory when SFM_HOST is not loopback.
SFM_HOST=127.0.0.1
# Actual listening port. Set this to match your platform's fixed probe port
# (e.g. 8443) instead of reconfiguring the probe. Health endpoints: / , /healthz
# (lightweight liveness) and /api/health (full subsystem report).
SFM_PORT=5000
SFM_DEBUG=false
# Generate with: openssl rand -hex 32
SFM_API_TOKEN=

# Optional comma-separated browser origins. Native Android does not need CORS.
SFM_CORS_ORIGINS=

# Optional local runtime paths and logging level.
SFM_DATABASE_PATH=
SFM_LOG_DIR=
SFM_LOG_LEVEL=INFO

# Path to a .env file the app should load itself (default: backend/.env).
# Only needed when the file lives elsewhere -- e.g. a K8s ConfigMap mounted at a
# custom path. Environment variables ALWAYS win over file entries, so orchestrator
# injection (envFrom/Secret) is never overridden by a stale baked-in .env.
# Set SFM_SKIP_ENV_FILE=1 to disable file loading entirely.
SFM_ENV_FILE=

# CJK font used to render menu images into .film. The container sets this to the
# fonts-wqy-zenhei path; leave empty locally to auto-probe common distro locations.
# A missing font is FATAL by design: PIL would silently render blank/tofu glyphs and
# that image would still be encoded, published and displayed -- the error would only
# be visible on the e-paper itself, with nothing failing anywhere in the pipeline.
SFM_FONT_PATH=

# Where generated .film files are stored (one sub-directory per device_id).
# Leave empty to default next to SFM_DATABASE_PATH. The container sets this to
# /data/devices so that films land inside the persistent volume together with the
# SQLite file -- if they diverge, a container rebuild leaves version rows in the
# database whose files are gone, and the device sees "manifest 200 but download 404".
SFM_FILM_DIR=

# Base URL used to build manifest film_url. LEAVE IT EMPTY unless you actually need
# to override it -- when empty the backend derives film_url from the address the DEVICE
# used for its own manifest request (via X-Forwarded-Proto / X-Forwarded-Host).
#
# Why empty is usually right: film_url must be reachable FROM THE DEVICE, and that
# address is often not something the backend can know -- container IPs are assigned
# randomly by the orchestrator, and a cloud entrypoint may be an Ingress hostname,
# a NodePort, or a load balancer that changes. If the device managed to fetch the
# manifest, the address it used is by definition reachable.
#
# Set it only when downloads must go through a different host than the API (CDN,
# dedicated download domain). Once set it MUST be https (the firmware rejects plain
# http manifests) and its host must appear in the server certificate SANs.
# A loopback value is treated as "not set" -- a device can never reach 127.0.0.1.
SFM_BASE_URL=

# Listening port of the caddy TLS terminator in docker-compose.yml (default 8443).
# Keep the port in SFM_BASE_URL in sync with this value.
#
# Note there is deliberately no "TLS site address" variable: caddy is configured with
# a port-only site (":8443"). Putting a host/IP there would make caddy treat it as an
# SNI matcher, and since RFC 6066 forbids IP addresses as SNI, clients reaching the
# server by IP send no SNI at all -- caddy then matches no site, picks no certificate
# and the handshake fails with "tlsv1 alert internal error".
# Which address is reachable is decided solely by the certificate SANs + SFM_BASE_URL.
SFM_TLS_PORT=8443

# Escape hatch for the deployment window before TLS is in place: allows a non-https
# SFM_BASE_URL while binding to a non-loopback address. Real-device Wi-Fi sync CANNOT
# work in this state -- it exists only so the stack can be brought up in stages.
# Keep false for anything beyond local integration work.
SFM_ALLOW_INSECURE_BASE_URL=false

# Start the APScheduler jobs when the app is loaded by a WSGI server (gunicorn).
# start_app() starts them by itself, so leave this false for local development.
# Requires --workers 1: multiple workers would each run their own scheduler.
SFM_ENABLE_SCHEDULER=false

# Render and publish the day's menu shortly before each meal so the device picks it up
# on its own polling cycle. This is the only automatic path to a screen update -- with
# it off, the picture only ever changes when someone taps a button in the app.
# Constrained by SFM_ENABLE_SCHEDULER: with no scheduler running this has no effect.
#
# INITIAL DEFAULT ONLY. This switch is user-facing: the app writes it through
# PUT /api/meal-schedule into the app_settings table, and a stored value ALWAYS WINS
# over this variable (src/settings_store.py). Editing this file after the user has
# touched the switch changes nothing -- deliberately, so a redeploy cannot silently
# undo a choice the user made. To reset, delete the 'auto_publish_enabled' row from
# app_settings.
SFM_AUTO_PUBLISH=true

# Comma-separated device_id allowlist for auto publishing. EMPTY MEANS ALL registered
# devices, which is the right default for one-fridge households: a hand-maintained list
# silently stops working after a device swap (device online, new version on the server,
# picture never changes).
#
# NOT user-configurable, on purpose. Whether a device_id sits in this list means
# "is this screen managed by this backend" -- an ops decision. Letting an app user edit
# it would hit OTHER devices behind the same backend, and the symptom is that the other
# device simply stops updating, with nothing in the app hinting at who changed it.
SFM_AUTO_PUBLISH_DEVICES=

# How many minutes before a meal to publish. Needs to cover wake-up, manifest fetch,
# a 209120-byte download and the ~20s e-paper refresh.
#
# INITIAL DEFAULT ONLY. Same as SFM_AUTO_PUBLISH: the app writes this through
# PUT /api/meal-schedule into app_settings ('auto_publish_lead_minutes') and a stored
# value ALWAYS WINS over this variable. The API accepts 5-240; a stored value outside
# that range (hand-edited, or left over from a downgrade -- 0 used to be accepted) is
# logged as a warning and this variable is used instead -- a bad config must not stall
# auto publishing, because nothing on that path is waiting for an answer and the only
# symptom would be "meal time came, the screen never changed".
#
# LOWER BOUND IS 5, NOT 0. The scheduler evaluates the publish window every 5 minutes
# (settings_store.DISPLAY_PUBLISH_TICK_MINUTES), and the window is "0 <= minutes-until-meal
# <= lead". A lead shorter than one tick has no tick guaranteed to land inside it, and 0
# would require a tick to hit the meal minute exactly -- that is not "publish right at
# meal time", it silently disables auto publishing while every switch still reads as on.
# Values below the bound are raised to it (with a warning), so this variable cannot
# express "never publish"; use SFM_AUTO_PUBLISH=0 for that.
SFM_AUTO_PUBLISH_LEAD_MIN=30
